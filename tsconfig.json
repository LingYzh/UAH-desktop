{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["node"],
        "lib": ["ES2023", "DOM"]
    },
    "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/runtime/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
